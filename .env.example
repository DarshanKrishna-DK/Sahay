# Sahay v2 environment. Copy to .env and fill in. Every value must be real: there is no
# sample-data fallback, and boot fails loudly if a required key is missing.

# --- Server ------------------------------------------------------------------
PORT=3000
# Interface to listen on. Default 127.0.0.1 (the tunnel, Tailscale Funnel or cloudflared, runs on the same machine).
# A cloud host that routes to the container (Render) needs HOST=0.0.0.0.
# HOST=127.0.0.1
# Rate limits and PIN lockouts need the real caller's address. Behind a tunnel on this machine every
# request comes from 127.0.0.1, so name the tunnel whose header to trust (all off by default; with
# none set, every caller shares one global bucket and PIN lockouts count per phone):
#   Tailscale Funnel / Serve (run.bat sets this): X-Forwarded-For, set by tailscaled
# TRUST_PROXY=tailscale
#   cloudflared: CF-Connecting-IP
# TRUST_CF_CONNECTING_IP=1
#   A hosting proxy on a private network (Hugging Face Spaces): right-most public X-Forwarded-For
# TRUST_FORWARDED_FOR=1
# Public HTTPS address of this server. Agora's cloud calls PUBLIC_URL/mcp for tools,
# so in development this is your tunnel URL (cloudflared or ngrok), in production the deploy URL.
PUBLIC_URL=https://your-tunnel.trycloudflare.com
# 32+ random bytes, hex. Signs browser sessions and the per-call MCP bearer.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=
# DB_FILE=data/sahay-v2.db

# --- Agora Conversational AI (console.agora.io) --------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# RESTful API credentials (Developer Toolkit > RESTful API)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Murf Falcon TTS (murf.ai/api/dashboard) -----------------------------------
MURF_API_KEY=
# global gave ~100 ms first byte in testing; "in" is also valid; "us-east" allows 5 concurrent
# Falcon streams instead of 2 (opt-in, longer round trip from India)
MURF_REGION=global
# Falcon voice ids per language (GET https://api.murf.ai/v1/speech/voices?model=FALCON)
MURF_VOICE_HI=hi-IN-khyati
MURF_VOICE_KN=kn-IN-harshitha
MURF_VOICE_EN=en-IN-anisha
# Distinct voice for the clearly labelled simulated vendor
MURF_VENDOR_VOICE_HI=hi-IN-chirag
MURF_VENDOR_VOICE_EN=en-IN-aarav

# --- Sarvam ASR (used by Agora; dashboard.sarvam.ai) -----------------------------
SARVAM_API_KEY=

# --- Groq (background extraction only; console.groq.com) ------------------------
GROQ_API_KEY=
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b

# --- Razorpay payment links: TEST keys only (rzp_test_...) -----------------------
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# --- Telegram follow-up notifications to the owner (optional) ------------------
TELEGRAM_BOT_TOKEN=

# Cost guards for a public URL (all optional; defaults shown)
SAHAY_MAX_OWNER_CALLS=3
SAHAY_MAX_NEGOTIATIONS=1
SAHAY_MAX_SOURCING_JOBS=3
SAHAY_MAX_CALL_SECONDS=2700
# Optional: when set, creating a business requires this access code (the onboarding form asks for it).
# New businesses are also limited to 5 per client IP per hour.
SAHAY_ACCESS_CODE=
