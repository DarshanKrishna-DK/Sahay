# Sahay environment configuration
# Copy to .env and fill in. Sahay makes only live calls - there is no sample-data
# fallback anywhere, so every key below must be real for the product to work.

# --- Anakin: ingestion (URL Scraper, Search, Crawl) -----------------------
# https://anakin.io/dashboard
ANAKIN_API_KEY=ask_your_key_here
ANAKIN_COUNTRY=in

# --- Groq: reasoning ------------------------------------------------------
# Verify what your key can actually use:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# Extraction runs on a DIFFERENT model on purpose: Groq rate-limits per model,
# so this gives high-volume extraction its own token budget.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Sarvam: Indic voice and language ------------------------------------
# https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_key_here
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_STT_MODEL=saarika:v2.5

# --- Telegram: the owner's interface -------------------------------------
# Create a bot with @BotFather and paste its token.
# Long polling is used by default, so no public URL is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
# TELEGRAM_WEBHOOK_URL=https://your.domain/telegram

# --- Razorpay: payment collection ----------------------------------------
# Test keys work fully: payment links are real and openable.
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret

# --- Procurement tuning ---------------------------------------------------
SHORTLIST_SIZE=5
MAX_CANDIDATES=12
MAX_NEGOTIATION_TURNS=10

# Which channel carries the vendor negotiation.
#   telegram-voice  live today - a real two-way spoken negotiation
#   pstn            real phone calls; needs the carrier settings below
NEGOTIATION_CHANNEL=telegram-voice

# --- Telephony (optional): real outbound calls ----------------------------
# Sarvam supplies the voice; a carrier supplies the line. Fill these in and set
# NEGOTIATION_CHANNEL=pstn to place real calls to vendor phone numbers.
# TELEPHONY_PROVIDER=exotel
# TELEPHONY_ACCOUNT_SID=
# TELEPHONY_AUTH_TOKEN=
# TELEPHONY_CALLER_ID=+91XXXXXXXXXX

PORT=3000
