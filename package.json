  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "agora-token": "2.0.6",
    "express": "^4.19.2",
    "pdfkit": "^0.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sileo": "0.1.6"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
