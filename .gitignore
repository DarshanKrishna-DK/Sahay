# Secrets: only the template ships
.env
.env.*
!.env.example

# Every dot-folder (.claude, .agents, .playwright-mcp, .superpowers, .vscode, .idea, ...) stays local.
# Dot-files that ship (.gitignore, .gitattributes, .gitguardian.yaml, .env.example) are not folders.
.*/

# Local tooling, agent notes and working docs: never pushed
docs/
.mcp.json
CLAUDE.md
AGENTS.md
skills-lock.json
spike/

# Dependencies, the live database and runtime output
node_modules/
data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.log
*.wav

# Screenshots, evidence and scratch artefacts
evidence/
screenshots/
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.mp4
/*.webm
/*.txt
/*.tmp
tmp/
scratch/
